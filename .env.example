# Copy to .env and fill in. Only DISCORD_TOKEN is required; the rest show defaults.
DISCORD_TOKEN=
# Lets RiceBot read the message you're replying to when you reply and mention
# it. Without this it can only read replies to its own messages. First turn on
# "Message Content Intent" under Bot in the Discord Developer Portal, or the
# bot can't connect.
# DISCORD_MESSAGE_CONTENT=false

# Greeter
GREETING_AUDIO=welcome.mp3
GREETING_MAX_SECS=30

# Local LLM server (llama.cpp's llama-server or any OpenAI-compatible server)
LLM_URL=http://127.0.0.1:8080
LLM_MODEL=local
LLM_TIMEOUT_SECS=180
# Longest reply in tokens (~0.75 words each). 0 = no limit.
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
# Match llama-server's --parallel
LLM_MAX_CONCURRENCY=2

# Chat
CHAT_HISTORY_MESSAGES=10
# "channel" (default): separate memory per text channel.
# "server": one memory shared by all channels in a server, so RiceBot remembers
# what was said in #general when you talk to it in #gaming. The history limit
# above then covers the whole server, so consider raising it.
# CHAT_MEMORY_SCOPE=channel
# The bot's personality. Defaults to PERSONALITY.md, falling back to a
# built-in prompt if that's missing. Setting it makes the file required.
# PERSONALITY_FILE=PERSONALITY.md
# People the bot knows, keyed by Discord ID (see people.example.toml).
# Defaults to people.toml, optional unless set here.
# Re-read both files without a restart: "@RiceBot !reload" (bot owner only).
# PEOPLE_FILE=people.toml

# Web search (optional). Set to a private SearXNG instance with the JSON format
# enabled (see deploy/searxng/). Leave unset to turn search off.
# Needs a tool-calling model and llama-server's --jinja option.
# SEARXNG_URL=http://127.0.0.1:8888
# Searches allowed per message, results read per search, and search timeout.
# SEARCH_MAX_CALLS=2
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT_SECS=15

# Log level, e.g. rice_bot=debug
# RUST_LOG=rice_bot=info,songbird=warn,serenity=warn
