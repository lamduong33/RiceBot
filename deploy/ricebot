#!/usr/bin/env bash
# Manage RiceBot and its llama-server (systemd user services).
set -euo pipefail
SVCS=(llama-server ricebot)
REPO=/home/lamanator/Desktop/Git/RiceBot
ENVF="$HOME/.config/ricebot/llama.env"

case "${1:-status}" in
  start|stop|restart) systemctl --user "$1" "${SVCS[@]}" ;;
  status)  systemctl --user --no-pager status "${SVCS[@]}" | grep -E '●|Active:|Main PID'
           grep '^MODEL=' "$ENVF" ;;
  logs)    journalctl --user -f -u "${2:-ricebot}" ;;
  update)  (cd "$REPO" && git pull && cargo build --release) && systemctl --user restart ricebot ;;
  model)
    case "${2:-}" in
      mag-mell) m="$HOME/models/MN-12B-Mag-Mell-R1-Q4_K_M.gguf" ;;
      cydonia)  m="$HOME/models/TheDrummer_Cydonia-24B-v4.3-Q4_K_M.gguf" ;;
      "")       grep '^MODEL=' "$ENVF"; exit 0 ;;
      *)        m="$2" ;;
    esac
    [[ -e "$m" ]] || { echo "No such model: $m" >&2; exit 1; }
    sed -i "s|^MODEL=.*|MODEL=$m|" "$ENVF"
    systemctl --user restart llama-server
    echo "llama-server now using $(basename "$m")" ;;
  *) echo "usage: ricebot [status|start|stop|restart|logs [llama-server]|update|model [mag-mell|cydonia|PATH]]" >&2; exit 1 ;;
esac
