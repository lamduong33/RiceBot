#!/usr/bin/env bash
# Manage RiceBot and its llama-server (systemd user services).
set -euo pipefail
SVCS=(llama-server ricebot)
REPO="${RICEBOT_REPO:-$HOME/Desktop/Git/RiceBot}"
ENVF="$HOME/.config/ricebot/llama.env"

case "${1:-status}" in
  start|stop|restart) systemctl --user "$1" "${SVCS[@]}" ;;
  # systemctl status exits non-zero when a service is down; keep going so the
  # model line still prints when you need it most.
  status)  systemctl --user --no-pager status "${SVCS[@]}" | grep -E '●|Active:|Main PID' || true
           grep '^MODEL=' "$ENVF" ;;
  logs)    journalctl --user -f -u "${2:-ricebot}" ;;
  # daemon-reload picks up any changes to the linked deploy/*.service files.
  # llama-server is only restarted when its unit changed, since reloading the
  # model takes a while.
  update)  cd "$REPO"
           unit_before=$(git rev-parse HEAD:deploy/llama-server.service 2>/dev/null || true)
           git pull && cargo build --release
           unit_after=$(git rev-parse HEAD:deploy/llama-server.service 2>/dev/null || true)
           for svc in "${SVCS[@]}"; do
             [[ -L "$HOME/.config/systemd/user/$svc.service" ]] ||
               echo "warning: ~/.config/systemd/user/$svc.service isn't linked to deploy/, so changes there don't apply (see RUNBOOK.md)" >&2
           done
           systemctl --user daemon-reload
           if [[ "$unit_before" != "$unit_after" ]]; then
             echo "deploy/llama-server.service changed, restarting llama-server"
             systemctl --user restart llama-server
           fi
           systemctl --user restart ricebot ;;
  model)
    case "${2:-}" in
      mag-mell) m="$HOME/models/MN-12B-Mag-Mell-R1-Q4_K_M.gguf" ;;
      cydonia)  m="$HOME/models/TheDrummer_Cydonia-24B-v4.3-Q4_K_M.gguf" ;;
      qwen)     m="$HOME/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf" ;;
      "")       grep '^MODEL=' "$ENVF"; exit 0 ;;
      *)        m="$2" ;;
    esac
    [[ -e "$m" ]] || { echo "No such model: $m" >&2; exit 1; }
    sed -i "s|^MODEL=.*|MODEL=$m|" "$ENVF"
    systemctl --user restart llama-server
    echo "llama-server now using $(basename "$m")" ;;
  *) echo "usage: ricebot [status|start|stop|restart|logs [llama-server]|update|model [mag-mell|cydonia|qwen|PATH]]" >&2; exit 1 ;;
esac
